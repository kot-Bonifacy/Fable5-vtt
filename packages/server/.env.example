# Port and host the VTT server listens on
PORT=3001
HOST=127.0.0.1

# Origin allowed for Socket.IO CORS (the Vite dev client)
CLIENT_ORIGIN=http://localhost:5173

# SQLite database file (relative to packages/server)
DATABASE_URL="file:./dev.db"

# GM account — created/updated automatically on server start
GM_NAME=MG
GM_PASSWORD=set-gm-password-here

# Secret used to sign the session cookie — use a long random string
COOKIE_SECRET=set-a-long-random-secret-here

# Session lifetime in days (optional, default 30)
# SESSION_TTL_DAYS=30

# Directory for user uploads — maps, tokens, handouts (optional; the default
# resolves to the repo-root uploads/ when running from packages/server)
# UPLOADS_DIR=../../uploads

# Directory of committed public data — status icons, sample assets (optional;
# defaults to the repo-root data/public when running from packages/server)
# DATA_PUBLIC_DIR=../../data/public

# Kopie zapasowe (etap 33). Katalog jest poza repozytorium, bo kopia niesie to
# samo, co data/private/ — treść kampanii i dane z podręcznika. Kopia powstaje
# przy starcie serwera i potem co BACKUP_INTERVAL_MINUTES; 0 wyłącza timer razem
# z kopią startową (ręczna kopia z panelu MG działa dalej).
# BACKUP_DIR=../../data/private/backups
# BACKUP_INTERVAL_MINUTES=60
# Rotacja: ile najświeższych kopii zostaje, i ile dób wstecz po jednej. Kopia
# przemianowana na nazwę spoza schematu (np. „przed-refaktorem") zostaje na zawsze.
# BACKUP_KEEP_HOURLY=24
# BACKUP_KEEP_DAILY=14
