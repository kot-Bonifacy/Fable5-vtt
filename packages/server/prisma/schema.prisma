generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  name         String   @unique
  role         String // "GM" | "PLAYER" (SQLite: no enum support in Prisma)
  passwordHash String?
  createdAt    DateTime @default(now())

  sessions         Session[]
  memberships      CampaignMember[]
  characters       Character[]
  chatMessages     ChatMessage[] @relation("ChatAuthor")
  whispersReceived ChatMessage[] @relation("ChatRecipient")
  tokens           Token[]
  drawings         MapDrawing[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Campaign {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  /// GM's session-wide switch for bot speech (stage 12). Bots still need their
  /// own voice enabled, so leaving this on changes nothing by itself.
  speechEnabled Boolean @default(true)

  invitations  Invitation[]
  members      CampaignMember[]
  characters   Character[]
  scenes       Scene[]
  chatMessages ChatMessage[]
  tokenAssets  TokenAsset[]
  bots         BotProfile[]
  compendium   CompendiumEntry[]
}

model CampaignMember {
  id         String   @id @default(cuid())
  campaignId String
  userId     String
  joinedAt   DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
}

model Invitation {
  id         String    @id @default(cuid())
  token      String    @unique
  campaignId String
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model Character {
  id         String   @id @default(cuid())
  name       String
  campaignId String
  /** Owning player; null = GM-controlled (NPC). */
  ownerId    String?
  /** Local portrait path (/uploads/...); null renders a placeholder. */
  portraitUrl String?
  /** System-specific sheet payload (CP RED: CpredCharacterData JSON, schemaVersion inside). */
  data       String   @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  owner    User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  tokens   Token[]
  bots     BotProfile[]

  @@index([campaignId])
}

/**
 * An LLM bot authored by the GM (NPC, companion or GM assistant). The whole
 * profile — persona, knowledge, generation params, learned lessons and the
 * stage-12 voice section — lives in one JSON column, so tuning the profile
 * shape never needs a migration.
 */
model BotProfile {
  id         String @id @default(cuid())
  campaignId String
  name       String
  /** Local portrait path (/uploads/...); null renders a placeholder. */
  portraitUrl String?
  /** BotProfileData JSON (schemaVersion inside). */
  data String @default("{}")
  /** Active in the current session — only active bots speak on chat. */
  active   Boolean @default(false)
  archived Boolean @default(false)
  /** Linked character sheet — companions with their own stats. */
  characterId String?
  /**
   * Scene the bot is pinned to („tryb w scenie"): there it also answers a
   * direct continuation of its own last line. Null = called by name only.
   */
  sceneId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign  Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  character Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  scene     Scene?     @relation(fields: [sceneId], references: [id], onDelete: SetNull)

  spokenMessages   ChatMessage[] @relation("ChatBot")
  whispersReceived ChatMessage[] @relation("ChatBotRecipient")

  @@index([campaignId])
}

// Autoincrement id doubles as a stable chronological cursor for pagination.
model ChatMessage {
  id          Int      @id @default(autoincrement())
  campaignId  String
  /**
   * Account responsible for the line. An NPC line — generated by a bot or typed
   * by the GM with `/jako` — is authored by the GM, so both look identical to
   * players; `botId` tells them apart internally.
   */
  authorId    String
  kind        String // "say" | "whisper" | "roll" | "gmroll" (SQLite: no enum support in Prisma)
  text        String
  recipientId String? // whisper target; null for public messages
  payload     String? // structured JSON (RollResult for roll kinds); null for plain text
  /** Bot that spoke this line; null for human lines. */
  botId       String?
  /** Whisper addressed to a bot (private player↔bot conversation). */
  recipientBotId String?
  /**
   * Display name at the time of speaking — kept so the transcript survives a
   * bot being renamed or deleted.
   */
  speakerName String?
  /** Scene the line was spoken in — the bot's short-term memory is per scene. */
  sceneId     String?
  createdAt   DateTime @default(now())

  campaign     Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  author       User        @relation("ChatAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  recipient    User?       @relation("ChatRecipient", fields: [recipientId], references: [id], onDelete: SetNull)
  bot          BotProfile? @relation("ChatBot", fields: [botId], references: [id], onDelete: SetNull)
  recipientBot BotProfile? @relation("ChatBotRecipient", fields: [recipientBotId], references: [id], onDelete: SetNull)
  scene        Scene?      @relation(fields: [sceneId], references: [id], onDelete: SetNull)

  @@index([campaignId, id])
  @@index([sceneId, id])
}

model Token {
  id      String  @id @default(cuid())
  sceneId String
  name    String
  /** Local asset path (/uploads/... or /public/...); null renders a placeholder disc. */
  imageUrl String?
  /** Top-left corner in scene (world) pixels. */
  x       Float
  y       Float
  /** Edge length in grid squares (1..4). */
  size    Int     @default(1)
  /** Owning player; null = GM-controlled (NPC). */
  ownerId String?
  hidden  Boolean @default(false)
  /** Linked character sheet; when set, the sheet's HP drives the token's bar. */
  characterId String?
  /** Own HP of a standalone token (unused while characterId is set). */
  hpCurrent Int?
  hpMax     Int?
  /** JSON array of status ids (SQLite has no native arrays). */
  statuses String @default("[]")
  /**
   * Numbers that go with those statuses (stage 14e), as a JSON object keyed by
   * status id: `{"on-fire":{"damage":6}}`. A separate column rather than an
   * entry in `statuses` because the ids are what the map, the filters and the
   * rules all read — a status that sometimes carries a payload would make every
   * one of those places ask what shape it is in.
   */
  statusData String @default("{}")
  /**
   * Fighting numbers of a token with no character sheet (stage 16b), as the
   * game system serialized them — the same opaque JSON bargain `turnState`
   * makes in 14b. Null = an extra nobody has statted, which is most tokens.
   *
   * On the token rather than in a stub Character row, because a statist is not
   * a person: it has no owner, no portrait, nothing to open in a sheet window,
   * and it dies when the token is deleted. Hit points stay in `hpCurrent` /
   * `hpMax` where they already were — two homes for one number is how they
   * drift apart.
   */
  combatProfile String?
  /**
   * How far this token sees, in metres (stage 18a). Null = as far as the walls
   * allow, which is the right default for a lit scene; darkness and light
   * sources arrive in 18b.
   */
  visionRange Float?
  /**
   * Light this token carries (stage 18b) — a torch, a lamp, a flare. A dim
   * radius of zero means it carries nothing, which is why these are plain
   * defaults rather than nullable columns: „no lamp" and „lamp of size zero"
   * must not be two different states.
   */
  lightBrightM Float   @default(0)
  lightDimM    Float   @default(0)
  lightColor   String  @default("#ffd9a0")
  lightFlicker Boolean @default(false)
  /// Lit right now. The one light field a player may write, on a token they control.
  lightOn      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scene     Scene      @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  owner     User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  character Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  /// Removing a token pulls it out of any running combat.
  combatants Combatant[]

  @@index([sceneId])
  @@index([characterId])
}

/** One uploaded token image — the campaign's simple asset library. */
model TokenAsset {
  id         String   @id @default(cuid())
  campaignId String
  /** Display name, defaults to the uploaded file's base name. */
  name       String
  url        String
  width      Int
  height     Int
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model Scene {
  id         String  @id @default(cuid())
  name       String
  campaignId String
  active     Boolean @default(false)

  // Background image (uploaded map); scene dimensions default to image size
  // but can exceed it (empty margin around the map).
  backgroundUrl    String?
  backgroundWidth  Int?
  backgroundHeight Int?
  width            Int     @default(4000)
  height           Int     @default(3000)

  gridMode        String  @default("grid") // "grid" | "gridless" (SQLite: no enums)
  gridSizePx      Float   @default(100)
  gridOffsetX     Float   @default(0)
  gridOffsetY     Float   @default(0)
  gridColor       String  @default("#000000")
  gridAlpha       Float   @default(0.35)
  gridVisible     Boolean @default(true)
  /** CP RED default: one square = 2 m — basis for ruler and DV (stage 15). */
  metersPerSquare Float   @default(2)

  /**
   * How this scene decides what a player may see (stages 17a, 18a):
   * "open" — everything, "fog" — the hand-painted fog of war, "dynamic" — the
   * field of view of the player's own tokens, blocked by walls.
   *
   * One column rather than two switches: „hand fog on *and* dynamic vision"
   * would be an unanswerable „why is this black?" at the table. Painted fog
   * shapes survive a trip through the other modes, so switching back restores
   * the exploration the group had already done.
   */
  visibility String @default("fog")

  /**
   * Is it dark in here (stage 18b)? Only meaningful while `visibility` is
   * "dynamic": darkness limits what a *token* sees, and the other two modes ask
   * tokens nothing. Off keeps every existing scene exactly as it was.
   */
  dark Boolean @default(false)
  /**
   * How far a token sees in the dark with no light at all, in metres. One grid
   * square by default — a fully black screen reads as a broken app rather than
   * as darkness, and proper darkvision is a character trait (stage 23).
   */
  darkSightM Float @default(2)

  /**
   * Does this scene remember where the party has already been (stage 18c)?
   *
   * Only meaningful while `visibility` is "dynamic", for the same reason
   * darkness is: the memory records what a token actually saw, and the other
   * two modes ask tokens nothing. On by default because a map that forgets a
   * room the moment you step out of it is the harder thing to explain at the
   * table — a GM who wants that turns it off per scene.
   */
  explore Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign     Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tokens       Token[]
  chatMessages ChatMessage[]
  bots         BotProfile[]
  combat       Combat?
  fogShapes    FogShape[]
  drawings     MapDrawing[]
  notes        MapNote[]
  walls        Wall[]
  lights       MapLight[]
  exploration  SceneExploration?

  @@index([campaignId, active])
}

/**
 * What the party has already seen on one scene (stage 18c) — one row per scene.
 *
 * The only place in this project where geometry is stored as a **grid** rather
 * than as a list of shapes, and deliberately so. What has to be remembered is
 * „visible *and* lit": the intersection of one polygon with the reach of lamps
 * standing somewhere else entirely, which a shape list cannot express without
 * clipping polygons against each other. A grid turns the same question into a
 * point test, has a size that depends on the map rather than on how long the
 * session ran, and — the property that matters most for something updated ten
 * times a second — merging into it is idempotent.
 *
 * The cell is the light mask's cell (half a grid square, one metre on a CP RED
 * map), anchored at the scene origin so a cell means the same square for every
 * viewer and across restarts.
 */
model SceneExploration {
  sceneId String @id
  /// Cell edge in scene pixels — stored, because changing the grid invalidates it.
  cell    Int
  cols    Int
  rows    Int
  /// Alternating run lengths, "unexplored,explored,…" in row-major order.
  data    String

  updatedAt DateTime @updatedAt

  scene Scene @relation(fields: [sceneId], references: [id], onDelete: Cascade)
}

/**
 * One painted fog shape (stage 17). The fog is an ordered list, not a bitmap:
 * the autoincrement id *is* the paint order, and the last shape covering a
 * point decides whether that point is revealed. Undo deletes the highest id,
 * „cover everything" clears the table for the scene (the base state is
 * covered), „reveal everything" clears it and stores one full-scene rectangle.
 */
model FogShape {
  id      Int    @id @default(autoincrement())
  sceneId String
  /// "reveal" | "hide" (SQLite: no enum support in Prisma)
  mode    String
  /// "stroke" (brush polyline + radius) | "rect"
  kind    String
  /// Geometry as JSON: stroke -> {points,radius}; rect -> {x,y,width,height}.
  data    String
  /**
   * Which set this shape belongs to (stage 18c). False — the hand-painted fog
   * of the "fog" mode; true — a GM override laid over dynamic vision, which
   * forces an area black or visible whatever the walls and lamps say.
   *
   * Two sets rather than one, because the same stroke means very different
   * things in the two modes: carrying a fog-mode „reveal" into dynamic mode
   * would switch off the walls over half the map, and the GM would rightly read
   * that as the vision system being broken.
   */
  override Boolean @default(false)

  createdAt DateTime @default(now())

  scene Scene @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@index([sceneId, id])
}

/**
 * One drawing on the map (stage 17b): a sketched route, a circled target, the
 * name of a room. Same storage idea as FogShape — geometry in a JSON column,
 * the autoincrement id doubling as the paint order — with two additions the
 * fog does not need: an author (a player may erase only their own lines) and
 * `gmOnly`, which keeps a drawing off every player socket.
 */
model MapDrawing {
  id       Int    @id @default(autoincrement())
  sceneId  String
  authorId String
  /// "path" (pencil and line tool) | "rect" | "ellipse" | "text"
  kind     String
  /// Geometry as JSON; the shape kind decides the fields (see shared/drawings).
  data     String
  /// Stroke colour as #rrggbb.
  color    String
  /// Stroke width in scene pixels.
  width    Int
  /// Rect and ellipse only: fill the interior at low alpha.
  filled   Boolean @default(false)
  /// GM layer: the server never emits this drawing to a player.
  gmOnly   Boolean @default(false)

  createdAt DateTime @default(now())

  scene  Scene @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([sceneId, id])
}

/**
 * One wall segment (stage 18a): the geometry that blocks sight.
 *
 * A wall is stored as a plain segment rather than a chain, because that is what
 * the raycast consumes — the editor draws chains, but a chain is only a series
 * of rows created in one gesture. Unlike fog and drawings this table is **never
 * emitted to a player**: the layout of a building is exactly the kind of thing
 * a party is supposed to discover. The one exception is a door flagged
 * `playerToggle`, which a player must be able to see in order to open it.
 */
model Wall {
  id      Int    @id @default(autoincrement())
  sceneId String
  /// "wall" (blocks sight) | "door" (blocks while closed) | "window" (never blocks)
  kind    String @default("wall")
  /// Doors only: an open door stops blocking sight.
  open    Boolean @default(false)
  /// Doors only: players may open and close this one themselves.
  playerToggle Boolean @default(false)
  /// Doors only (stage 18d): bolted. The GM still works it; a player's click does
  /// nothing and the flag never reaches their socket.
  locked Boolean @default(false)
  /// Endpoints in scene (world) pixels.
  x1 Float
  y1 Float
  x2 Float
  y2 Float

  createdAt DateTime @default(now())

  scene Scene @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@index([sceneId])
}

/**
 * A light standing on the map (stage 18b) — a street lamp, a burning barrel, the
 * glow of a vending machine.
 *
 * GM data like the walls, and for the same reason: the shape a light takes is
 * the shape of the room it is in. A player never receives a row from this table;
 * they receive the light *level* of the ground they can already see, plus the
 * position of lamps in their line of sight.
 */
model MapLight {
  id      Int    @id @default(autoincrement())
  sceneId String
  /// Centre in scene (world) pixels.
  x Float
  y Float
  /// Full-brightness radius in metres.
  brightM Float @default(4)
  /// Outer radius in metres; the server keeps it at or above brightM.
  dimM    Float @default(10)
  color   String @default("#ffd9a0")
  /// Renderer-side alpha wobble; never a network event.
  flicker Boolean @default(false)
  /// A switched-off light stays on the map, dark, ready to be switched back on.
  enabled Boolean @default(true)

  createdAt DateTime @default(now())

  scene Scene @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@index([sceneId])
}

/// A pin on the GM layer (stage 17): icon plus text, never emitted to a player.
model MapNote {
  id      String @id @default(cuid())
  sceneId String
  x       Float
  y       Float
  /// Pin glyph from the shared closed set.
  icon    String @default("📌")
  text    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scene Scene @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@index([sceneId])
}

/// One running fight, bound to a scene (stage 14). Ending combat deletes the
/// row — round history is deliberately not persisted.
model Combat {
  id      String @id @default(cuid())
  /// A scene runs at most one combat at a time.
  sceneId String @unique
  /// 0 = participants gathered, round 1 has not started yet.
  round   Int    @default(0)
  /// Whose turn it is; null before the first round starts.
  activeCombatantId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scene      Scene       @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  combatants Combatant[]
}

/// A token taking part in a combat. The token stays the single source of
/// truth for name, portrait, HP and visibility — this row only adds the
/// tracker's own data (initiative, tie-breaker, manual position).
model Combatant {
  id       String @id @default(cuid())
  combatId String
  tokenId  String
  /// Rolled initiative (1d10 + REF in CP RED); null = not rolled yet.
  initiative Int?
  /// Secondary sort supplied by the game system (CP RED: REF); null = unknown.
  tieBreak   Int?
  /// Manual position inside a tie group — the GM's drag has the final say.
  order      Int    @default(0)
  /// What is left of this participant's turn (stage 14b), as the game system
  /// serialized it. Opaque to the tracker: the core only asks the system for a
  /// fresh one at the start of a turn and hands it back for judging spends.
  /// Null = the turn has not started yet.
  turnState  String?
  /// What the game system wants baked into this participant's *next* turn
  /// (stage 14e), serialized the same opaque way `turnState` is. A spine injury
  /// takes away the Action of a turn that has not started yet — and may well be
  /// drawn during somebody else's turn — so the debt needs a home outside the
  /// turn that is currently running. Cleared the moment it is spent.
  nextTurnState  String?
  /// Which of this participant's turn hooks have already fired, and in which
  /// round (stage 14e), as the game system serialized it. Deliberately *not*
  /// part of `turnState`: a budget is handed out fresh whenever a turn begins,
  /// and „begins" includes the GM stepping back and forward through the queue
  /// or pressing „Zwróć turę" — a ledger inside it would be wiped by exactly
  /// the actions it exists to survive, and the second pass would set the same
  /// NPC on fire again.
  turnEffects    String?
  /// „Wstrzymanie Akcji": what will make the reserved Action happen. Null when
  /// nothing is held, or when a queue value was declared instead of a trigger.
  heldTrigger    String?
  /// Initiative value the held Action was declared for; null when the player
  /// described a trigger instead. Both null with `heldAt` set = no hold.
  heldInitiative Int?
  /// Set while a hold is declared — the pair above may both be null (a trigger
  /// of "wtedy, gdy zobaczę" typed as empty text still reserves the Action).
  held           Boolean @default(false)
  /// One-shot pass from the GM: the next refused spend goes through anyway.
  actionBypass   Boolean @default(false)
  /// The Hold this participant is *being held in* — id of the Attacker's
  /// Combatant row (stage 14d). Null on the Attacker's own row and on anybody
  /// free: the relation is stored once, on the Defender, so „kto kogo" cannot
  /// disagree with itself. Not a foreign key: both rows die with the combat.
  grappledById   String?
  /// Rounds this participant has been choked in a row, and the round the last
  /// squeeze happened in — „3 Rundy pod rząd" needs both to tell a streak from
  /// a pause.
  chokeStreak    Int     @default(0)
  chokeRound     Int?
  /// The Attacker is using this (Held) participant as a Ludzka tarcza.
  humanShield    Boolean @default(false)

  createdAt DateTime @default(now())

  combat Combat @relation(fields: [combatId], references: [id], onDelete: Cascade)
  token  Token  @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@unique([combatId, tokenId])
  @@index([combatId])
}

/// Compendium entries typed in by the GM (stage 13). Imported rulebook data
/// lives in JSON files under data/private and is never written here — this
/// table only holds what the group made up itself, so the campaign database
/// stays free of copyrighted content.
model CompendiumEntry {
  id         String   @id @default(cuid())
  campaignId String
  /// Stable slug used by character sheets, e.g. "weapon.zgrzyt-9".
  slug       String
  category   String
  /// Full entry as JSON, validated with the shared schema before writing.
  data       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, slug])
  @@index([campaignId])
}
