generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  name         String   @unique
  role         String // "GM" | "PLAYER" (SQLite: no enum support in Prisma)
  passwordHash String?
  createdAt    DateTime @default(now())

  sessions         Session[]
  memberships      CampaignMember[]
  characters       Character[]
  chatMessages     ChatMessage[] @relation("ChatAuthor")
  whispersReceived ChatMessage[] @relation("ChatRecipient")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Campaign {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  invitations  Invitation[]
  members      CampaignMember[]
  characters   Character[]
  scenes       Scene[]
  chatMessages ChatMessage[]
}

model CampaignMember {
  id         String   @id @default(cuid())
  campaignId String
  userId     String
  joinedAt   DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
}

model Invitation {
  id         String    @id @default(cuid())
  token      String    @unique
  campaignId String
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

// Skeleton model — expanded in stage 07 (character sheet).
model Character {
  id         String   @id @default(cuid())
  name       String
  campaignId String
  ownerId    String?
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  owner    User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
}

// Autoincrement id doubles as a stable chronological cursor for pagination.
model ChatMessage {
  id          Int      @id @default(autoincrement())
  campaignId  String
  authorId    String
  kind        String // "say" | "whisper" (SQLite: no enum support in Prisma)
  text        String
  recipientId String? // whisper target; null for public messages
  createdAt   DateTime @default(now())

  campaign  Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  author    User     @relation("ChatAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  recipient User?    @relation("ChatRecipient", fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([campaignId, id])
}

// Skeleton model — expanded in stage 04 (map & scenes).
model Scene {
  id         String   @id @default(cuid())
  name       String
  campaignId String
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}
