    "start": "node --env-file-if-exists=.env dist/main.js",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.1",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@vtt/shared": "workspace:*",
    "fastify": "^5.4.0",
    "image-size": "^2.0.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "prisma": "^7.8.0",
    "socket.io-client": "^4.8.3",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
