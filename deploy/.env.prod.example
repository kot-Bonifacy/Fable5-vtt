# Copy to deploy/.env.prod on the VPS (never committed): cp .env.prod.example .env.prod
# Paths, ports and TRUST_PROXY are fixed in docker-compose.yml — only secrets and
# choices go here. Secrets: openssl rand -hex 32

# Origin of the public site (Socket.IO CORS).
CLIENT_ORIGIN=https://vtt.tatanga.eu

# Owner's GM account. GM_PASSWORD is written to the account on EVERY start.
GM_NAME=MG
GM_PASSWORD=

# Signs session cookies. Changing it logs everybody out.
COOKIE_SECRET=

# Admin account (stage 53). A database copied from the PC already holds it with its
# password — then leave both empty. On a fresh database: temporary password, changed
# at the first login.
# VTT_ADMIN_LOGIN=pantosz
# VTT_ADMIN_PASSWORD=

# open | closed — the admin's switch in the panel wins once it has been used.
VTT_REGISTRATION=open

# Server-side snapshots (db + uploads) into VTT_DATA_DIR/backups, with rotation.
BACKUP_INTERVAL_MINUTES=60
BACKUP_KEEP_HOURLY=24
BACKUP_KEEP_DAILY=14

# The bots' decision log quotes prompts with NPC secrets — off on the VPS.
BOT_DECISION_LOG=

# AI gateway on the GM's PC over Tailscale (second step of docs/DEPLOY.md).
# Without it the bots show as offline and the rest of the VTT works.
# AI_GATEWAY_URL=http://100.x.y.z:8100
# AI_GATEWAY_API_KEY=

# Docker-side settings read by docker compose itself (not by the server).
# VTT_DATA_DIR=/opt/docker-apps/vtt-data
# NPM_NETWORK=npm_default
