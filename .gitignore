# Bazy wektorowe RAG (etap 19a) — pochodne materiału źródłowego, odtwarzalne
# jednym przebiegiem indeksowania. Fragmenty w środku to treść podręcznika.
.rag-bench/
*.sqlite3

# Editors
.idea/
.vscode/
!.vscode/extensions.json

# Przegląd ikon (tools/icon-review) — strona jest w całości pochodną plików SVG
# z repozytorium, waży ćwierć megabajta i odtwarza się jednym `python build.py`.
# W repo zostaje generator, nie jego wydruk.
tools/icon-review/przeglad-ikon.html

# Instrukcja dla innego modelu, trzymana lokalnie (decyzja MG 12.09.2026).
AGENTS.md

# Źródła tekstur karty (etap naprawy 2c) — pobierane przez tools/art/sheet-paper.py.
tools/art/.cache/

# Playwright MCP (.mcp.json) — profile przeglądarek, zrzuty i hasło MG w secrets.env.
# Profil trzyma ciasteczko sesji MG, więc jest tak samo tajny jak samo hasło.
.playwright-mcp/

# Instancja testów E2E (packages/e2e, testy.md 4.1): baza, uploady z materiałów MG,
# kopie, punkty kontrolne i raporty. Materiały MG nigdy nie trafiają do repo.
.e2e/
