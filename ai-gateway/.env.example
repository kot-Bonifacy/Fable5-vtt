# Skopiuj do .env i dostosuj ścieżki. Plik .env jest w .gitignore.

# --- gateway ---
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8100
# Klucz wymagany w nagłówku X-API-Key. Pusty = brak autoryzacji (tylko localhost!).
# Po etapie 27 gateway jest osiągalny z VPS przez Tailscale — wtedy ustaw długi losowy klucz
# i ten sam wpisz w AI_GATEWAY_API_KEY serwera VTT.
GATEWAY_API_KEY=
GATEWAY_LOG_LEVEL=INFO

# --- llama-server ---
# Ustaw obie ścieżki, żeby gateway sam uruchamiał i nadzorował llama-server.
# Zostaw puste, jeśli llama-server odpalasz osobno (gateway tylko się do niego podłączy).
GATEWAY_LLAMA_BINARY=C:/AI/llm/llama.cpp/llama-server.exe
GATEWAY_LLAMA_MODEL=C:/AI/llm/models/Qwythos-9B-v2-Q8_0.gguf
GATEWAY_LLAMA_URL=http://127.0.0.1:8080
GATEWAY_LLAMA_CTX_SIZE=32768
GATEWAY_LLAMA_GPU_LAYERS=999
GATEWAY_LLAMA_FLASH_ATTN=true
# Dodatkowe argumenty llama-server, np. kwantyzacja KV cache przy dużym kontekście:
# GATEWAY_LLAMA_EXTRA_ARGS=--cache-type-k q8_0 --cache-type-v q8_0
GATEWAY_LLAMA_EXTRA_ARGS=

# --- generacja ---
GATEWAY_DEFAULT_MAX_TOKENS=512
# Żądania z rozumowaniem (asystent MG) dostają wyższy limit i osobny budżet na blok think —
# inaczej model potrafi przemyśleć całą pulę tokenów i zwrócić pustą odpowiedź.
GATEWAY_REASONING_MAX_TOKENS=1536
GATEWAY_REASONING_BUDGET=640
GATEWAY_DEFAULT_TEMPERATURE=0.6
GATEWAY_DEFAULT_TOP_P=0.95
GATEWAY_DEFAULT_TOP_K=20
GATEWAY_GENERATION_TIMEOUT=120
GATEWAY_MAX_QUEUE_LENGTH=16

# --- RAG: pamięć długoterminowa (etap 19a) ---
# Embeddingi liczą się na CPU przez onnxruntime — 0 GB VRAM, więc cała karta
# zostaje modelowi. Model pobiera się z HuggingFace przy pierwszym użyciu (~2,3 GB).
GATEWAY_RAG_ENABLED=true
# bge-m3 | multilingual-e5-large. bge-m3 wybrany pomiarem: 10/10 trafień w top-5
# na 10 polskich pytaniach o zasady (e5: 9/10). Zmiana modelu unieważnia indeks.
GATEWAY_RAG_MODEL=bge-m3
# 0 = domyślna liczba wątków onnxruntime.
GATEWAY_RAG_THREADS=0
GATEWAY_RAG_BATCH_SIZE=8
# Baza wektorowa. Nie backupuj — odtwarza się jednym przebiegiem indeksowania.
GATEWAY_RAG_DB_PATH=C:/AI/vtt-rag/rag.sqlite3
# Pusty = domyślny cache HuggingFace.
GATEWAY_RAG_CACHE_DIR=
# Podręcznik czytany z DYSKU TEJ MASZYNY — treść nie przechodzi przez serwer VTT.
GATEWAY_RAG_RULEBOOK_DIR=../data/private/rulebook/manual/CPRED-podrecznik
GATEWAY_RAG_CHUNK_TOKENS=420
GATEWAY_RAG_CHUNK_OVERLAP=60
GATEWAY_RAG_TOP_K=5
# Wagi fuzji RRF (semantyka / pełny tekst) — 0,3 zmierzone jako optimum.
GATEWAY_RAG_DENSE_WEIGHT=1.0
GATEWAY_RAG_KEYWORD_WEIGHT=0.3
